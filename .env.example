# 本番(VM)用 .env のテンプレート。これをコピーして .env を作り、値を埋める:
#   cp .env.example .env && nano .env
# ※ .env は Git に上げません(.gitignore 済み)。

# 許可リスト: ログインを許可する Gmail をカンマ区切り
ALLOWLIST=

# Google OAuth (クライアントID/シークレット)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT=https://a1-takeoff.duckdns.org/auth/callback

# セッション署名用ランダム文字列(setup.sh が自動生成して入れます)
SESSION_SECRET=

# クラウド(rclone)モード: リモート名。サービスアカウントの rclone リモートを "gdrive:" で作成
RCLONE_REMOTE=gdrive:
RCLONE_CONF=/home/USER/.config/rclone/rclone.conf

# ローカルfsモード時のみ使用(クラウドでは無視される)
BASE_DIR=I:/マイドライブ/A1現場情報

PORT=5050

# 表示する現場の絞り込み(工程表スプレッドシート)
# シートの「現場コード」列に載っている現場だけを一覧に出す。突き合わせは現場コード6桁。
# 既定値はコードに埋め込み済みなので通常は未設定でよい(SHEET_ID/SHEET_GID)。
# SA_KEY_FILE も未設定なら rclone.conf の service_account_file を自動流用する。
# ※このスプレッドシートを、rcloneで使っているサービスアカウントのメールに「閲覧者」で共有すること。
#   共有していない/取得失敗の場合は絞り込まず全件表示になる(フェイルオープン)。
# SHEET_ID=1zL-SZjpFGc2Cmne3Y2y8GBEExAAf8ivOD4e0bRgEbB8
# SHEET_GID=21800988
# SA_KEY_FILE=/home/USER/takeoff-sa.json
